# PHPArm Mobile App Environment Configuration

# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://your-domain.com/api
EXPO_PUBLIC_BUILD_VARIANT=development

# Expo / EAS Configuration
EXPO_OWNER=your-expo-username
EAS_PROJECT_ID=your-eas-project-id

# iOS App Store Connect (for automated submissions)
APPLE_ID=your-apple-id@example.com
ASC_APP_ID=1234567890
APPLE_TEAM_ID=XXXXXXXXXX

# Android: Place google-play-service-account.json in this directory
# Firebase: Place google-services.json in this directory
