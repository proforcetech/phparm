{
  "name": "PHPArm Auto Repair",
  "short_name": "PHPArm",
  "description": "Auto repair shop management — schedule, estimate, work orders, dispatch, and field tools.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "lang": "en-US",
